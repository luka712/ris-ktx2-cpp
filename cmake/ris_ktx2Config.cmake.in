@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Ktx CONFIG)
find_dependency(VulkanHeaders CONFIG)
# spdlog is a private dependency, but is required when linking a static build.
find_dependency(spdlog CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/ris_ktx2Targets.cmake")

check_required_components(ris_ktx2)
